{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "DescribeParaLeerReglas",
            "Effect": "Allow",
            "Action": [
                "ec2:DescribeSecurityGroups",
                "ec2:DescribeSecurityGroupRules"
            ],
            "Resource": "*"
        },
        {
            "Sid": "ModificarSoloEstasReglas",
            "Effect": "Allow",
            "Action": [
                "ec2:ModifySecurityGroupRules"
            ],
            "Resource": [
                "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:security-group/sg-xxxxxxxxxxxxxxxxx",
                "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:security-group-rule/sgr-xxxxxxxxxxxxxxxxx",
                "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:security-group-rule/sgr-yyyyyyyyyyyyyyyyy",
                "arn:aws:ec2:<REGION>:<ACCOUNT_ID>:security-group-rule/sgr-zzzzzzzzzzzzzzzzz"
            ]
        },
        {
            "Sid": "DenegarModificacionDirectaSGs",
            "Effect": "Deny",
            "Action": [
                "ec2:AuthorizeSecurityGroupIngress",
                "ec2:AuthorizeSecurityGroupEgress",
                "ec2:RevokeSecurityGroupIngress",
                "ec2:RevokeSecurityGroupEgress"
            ],
            "Resource": "*"
        }
    ]
}
