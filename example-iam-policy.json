{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "DescribeParaLeerReglas",
            "Effect": "Allow",
            "Action": [
                "ec2:DescribeSecurityGroups",
                "ec2:DescribeSecurityGroupRules"
            ],
            "Resource": "*"
        },
        {
            "Sid": "ModificarSoloEstasReglas",
            "Effect": "Allow",
            "Action": [
                "ec2:ModifySecurityGroupRules"
            ],
            "Resource": [
                "arn:aws:ec2:eu-south-2:024848440891:security-group/sg-0e62178f6d94e6afa",
                "arn:aws:ec2:eu-south-2:024848440891:security-group-rule/sgr-034cc20fd7411261f",
                "arn:aws:ec2:eu-south-2:024848440891:security-group-rule/sgr-065742a5c3b8da466",
                "arn:aws:ec2:eu-south-2:024848440891:security-group-rule/sgr-0a9cad559ad18fd69"
            ]
        },
        {
            "Sid": "DenegarModificacionDirectaSGs",
            "Effect": "Deny",
            "Action": [
                "ec2:AuthorizeSecurityGroupIngress",
                "ec2:AuthorizeSecurityGroupEgress",
                "ec2:RevokeSecurityGroupIngress",
                "ec2:RevokeSecurityGroupEgress"
            ],
            "Resource": "*"
        }
    ]
}
